// The mod runs inside Claude Code, which has no Node or Bun globals, so this
// pass types it against the engine's declarations alone. tsconfig.json is
// the fleet's copy (fleet-sync keeps it byte-identical) and types every file
// under Bun, the scripts included.
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["es2023"],
    "types": []
  },
  "include": ["hooks", "tests", "types"]
}
