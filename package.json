{
  "name": "tool-lines-mod",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "scripts": {
    "check": "bun run fmt:check && bun run lint && bun run typecheck && bun run lint:md && bun test",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint --type-aware --deny-warnings .",
    "lint:fix": "oxlint --type-aware --deny-warnings --fix .",
    "typecheck": "tsc --noEmit",
    "typecheck:mod": "bun scripts/claude-code-types.ts && tsc --noEmit -p tsconfig.mod.json",
    "lint:md": "markdownlint-cli2",
    "knip": "knip"
  },
  "trustedDependencies": [
    "lefthook"
  ],
  "devDependencies": {
    "@tsconfig/bun": "1.0.11",
    "@tsconfig/strictest": "2.0.8",
    "@types/bun": "1.4.4",
    "claude-code": "file:./bun-shims/claude-code",
    "knip": "6.44.1",
    "lefthook": "2.2.2",
    "markdownlint-cli2": "0.24.0",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "typescript": "7.0.2"
  }
}
